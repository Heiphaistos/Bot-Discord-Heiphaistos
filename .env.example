# ======================= HeiphaisBot — configuration =======================
# Copiez ce fichier en .env et remplissez les valeurs. Les variables marquées (obligatoire) sont indispensables.

# --- Discord (obligatoire) — https://discord.com/developers/applications ---
DISCORD_TOKEN=                # (obligatoire) Jeton du bot (onglet Bot)
DISCORD_CLIENT_ID=            # (obligatoire) Application ID
DISCORD_CLIENT_SECRET=        # (obligatoire pour la connexion Discord au panel) onglet OAuth2
OWNER_IDS=                    # IDs Discord des propriétaires du bot, séparés par des virgules (accès total panel/CLI/commandes système)
DEV_GUILD_ID=                 # Optionnel : déployer les commandes uniquement sur ce serveur (instantané) au lieu de global (~1h)
AUTO_DEPLOY_COMMANDS=true
PRESENCE_INTENT=false          # true = active l'intent Presence (statut en ligne : priorité staff en ligne pour les tickets, compteurs « en ligne »)     # Déployer automatiquement les commandes slash au démarrage si elles ont changé
DEFAULT_PREFIX=!              # Préfixe des commandes texte
BOT_NAME=HeiphaisBot
BOT_ACTIVITY=/help | HeiphaisBot
BOT_ACTIVITY_TYPE=Playing     # Playing | Listening | Watching | Competing | Custom
BOT_STATUS=online             # online | idle | dnd | invisible
EMBED_COLOR=#5865F2

# --- Panel web ---
PANEL_ENABLED=true
PANEL_HOST=0.0.0.0
PANEL_PORT=3000
PANEL_PUBLIC_URL=http://localhost:3000   # URL publique (ex: https://bot.mondomaine.fr) — doit être ajoutée aux « Redirects » OAuth2 : <URL>/auth/callback
PANEL_SESSION_SECRET=         # (obligatoire) openssl rand -hex 32
PANEL_ADMIN_PASSWORD=         # Optionnel : mot de passe de connexion locale au panel (accès propriétaire sans Discord)
PANEL_TRUST_PROXY=true        # true derrière nginx/traefik

# --- Stockage & logs ---
DATA_DIR=data                 # Dossier des données (base SQLite, transcripts, sauvegardes, archives, enregistrements)
DATABASE_PATH=                # Optionnel : chemin explicite de la base (défaut DATA_DIR/heiphaisbot.db)
LOG_LEVEL=info                # trace | debug | info | warn | error
NODE_ENV=production

# --- Intégrations ForgeArchive / ForgeHook (vos applications) ---
FORGEARCHIVE_URL=             # ex: https://archive.mondomaine.fr
FORGEARCHIVE_API_KEY=
FORGEHOOK_URL=                # ex: https://hook.mondomaine.fr
FORGEHOOK_API_KEY=
FORGEHOOK_SECRET=             # Secret HMAC pour signer les évènements envoyés à ForgeHook

# --- IA (optionnel) ---
ANTHROPIC_API_KEY=            # Active /ask, résumés, modération assistée, filtre NSFW IA
ANTHROPIC_MODEL=claude-sonnet-5

# --- Musique ---
YTDLP_PATH=yt-dlp             # Binaire yt-dlp (installé par deploy/install.sh)
MUSIC_MAX_QUEUE=200

# --- Clés d'API optionnelles (peuvent aussi être définies par serveur dans le panel) ---
DEEPL_API_KEY=
OCR_SPACE_API_KEY=
GOOGLE_SAFE_BROWSING_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
REMOVEBG_API_KEY=

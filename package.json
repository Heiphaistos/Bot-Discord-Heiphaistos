    "@snazzah/davey": "^0.1.6",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.3",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.5",
    "ffmpeg-static": "^5.2.0",
    "jsqr": "^1.4.0",
    "libsodium-wrappers": "^0.7.15",
